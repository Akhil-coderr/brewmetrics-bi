table Fact_Sales
	lineageTag: dbf8d288-2ed3-4a25-bd37-1e1bdecd0da8

	measure 'Total Sales' = SUM(Fact_Sales[sales_amount])
		lineageTag: 5fd309f0-58dc-4879-85d7-8e8f95e62cb7

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Previous Month Sales' =
			
			CALCULATE(
			    [Total Sales],
			    DATEADD(Dim_Date[date], -1, MONTH))
		lineageTag: eab34d0a-dcd1-46ad-bb01-8c970a813f09

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'MoM Growth %' =
			
			DIVIDE(
			    [Total Sales] - [Previous Month Sales],
			    [Previous Month Sales]
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 341a3c60-9684-41f1-9f42-52c9f7c15759

	measure 'Running Total Sales' =
			
			CALCULATE(
			    [Total Sales],
			    FILTER(
			        ALL(Dim_Date[date]),
			        Dim_Date[date] <= MAX(Dim_Date[date])
			    )
			)
		lineageTag: ce628126-6d52-4aea-91d7-fd65d3739d8e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Product Rank' =
			
			RANKX(
			    ALL(Dim_Product[item]),
			    [Total Sales],
			    ,
			    DESC,
			    DENSE
			)
		formatString: 0
		lineageTag: 2d245945-1f88-4339-9fb3-3d6a2a26827b

	measure 'Average Sales per Transaction' =
			
			DIVIDE(
			    [Total Sales],
			    DISTINCTCOUNT(Fact_Sales[sale_id])
			)
		lineageTag: 8fe85985-05fa-408c-96d4-5f48d295df0f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column sale_id
		dataType: int64
		formatString: 0
		lineageTag: 555aa195-6741-4b34-b36e-cbd2a28f264a
		summarizeBy: sum
		sourceColumn: sale_id

		annotation SummarizationSetBy = Automatic

	column date
		dataType: dateTime
		formatString: Long Date
		lineageTag: 77db948b-4fc8-457f-8a24-41f8b6a2abf2
		summarizeBy: none
		sourceColumn: date

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

